{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./",
    "paths": {
      "@haraka/shared-types": ["../packages/shared-types/src/index.ts"],
      "@haraka/shared-types/*": ["../packages/shared-types/src/*"],
      "@haraka/validation": ["../packages/validation/src/index.ts"],
      "@haraka/validation/*": ["../packages/validation/src/*"],
      "@haraka/theme": ["../packages/theme/src/index.ts"],
      "@haraka/theme/*": ["../packages/theme/src/*"],
      "@haraka/i18n": ["../packages/i18n/src/index.ts"],
      "@haraka/i18n/*": ["../packages/i18n/src/*"],
      "@haraka/api-client": ["../packages/api-client/src/index.ts"],
      "@haraka/api-client/*": ["../packages/api-client/src/*"]
    }
  },
  "include": ["src"]
}

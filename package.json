{
  "name": "haraka",
  "version": "0.1.0",
  "private": true,
  "description": "Haraka — On-demand delivery platform for coastal Kenya",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @haraka/api build",
    "build:frontend": "pnpm --filter @haraka/web build",
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @haraka/api dev",
    "dev:frontend": "pnpm --filter @haraka/web dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\" --ignore-path .gitignore",
    "type-check": "pnpm -r type-check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "clean": "pnpm -r clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @haraka/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @haraka/database migrate:deploy",
    "db:seed": "pnpm --filter @haraka/database seed",
    "db:studio": "pnpm --filter @haraka/database studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}

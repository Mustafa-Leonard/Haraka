  @@map("refunds")
}

model ReconciliationRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodStart   DateTime
  periodEnd     DateTime
  totalJobs     Int
  totalRevenue  Int // minor units

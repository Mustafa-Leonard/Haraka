  actorId     String?     @db.Uuid
  actorRole   String?     @db.VarChar(50)
  subjectId   String?     @db.Uuid
  subjectType String?     @db.VarChar(50)
  action      AuditAction
  resource    String      @db.VarChar(100)
  resourceId  String?     @db.VarChar(100)
  oldValue    Json? // redacted sensitive fields
  newValue    Json?

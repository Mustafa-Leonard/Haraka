  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@haraka/shared-types": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

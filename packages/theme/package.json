{
  "name": "@haraka/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Haraka design system — tokens, CSS variables, and brand assets",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./src/styles/index.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "require": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

# =============================================================================
# HARAKA ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in all required values.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=development
# development | staging | production

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Public-facing API URL (used in callbacks, emails, SMS links)
API_PUBLIC_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# -----------------------------------------------------------------------------
# WEB APPLICATION
# -----------------------------------------------------------------------------
WEB_PORT=5173
WEB_PUBLIC_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Account verification and password recovery emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=Haraka <no-reply@example.com>

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Full PostgreSQL connection string with PostGIS
DATABASE_URL=postgresql://haraka:changeme@localhost:5432/haraka
# Test database (used during automated tests)
DATABASE_TEST_URL=postgresql://haraka:changeme@localhost:5432/haraka_test

# Database connection pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Optional Redis password
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# JWT signing secret (minimum 64 random bytes, hex or base64)
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_BYTES_HEX_OR_BASE64_MINIMUM

# JWT access token expiry (short)
JWT_ACCESS_EXPIRY=15m

# Refresh token expiry
JWT_REFRESH_EXPIRY=30d

# Cookie secret for signing refresh cookies
COOKIE_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_BYTES

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# OTP maximum attempts before lockout
OTP_MAX_ATTEMPTS=5

# OTP request cooldown in seconds
OTP_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# ADMIN MFA (TOTP)
# -----------------------------------------------------------------------------
# Application name shown in authenticator apps
TOTP_APP_NAME=Haraka Admin

# Issuer for TOTP
TOTP_ISSUER=haraka.co.ke

# Number of recovery codes to generate
TOTP_RECOVERY_CODE_COUNT=10

# -----------------------------------------------------------------------------
# ENCRYPTION
# -----------------------------------------------------------------------------
# 32-byte hex key for AES-256-GCM field encryption (64 hex chars)
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FIELD_ENCRYPTION_KEY_HERE

# Key ID for rotation tracking
FIELD_ENCRYPTION_KEY_ID=v1

# -----------------------------------------------------------------------------
# PRICING
# -----------------------------------------------------------------------------
# Quote lock duration in minutes
QUOTE_LOCK_MINUTES=5

# Default boda base fare in minor units (KES * 100)
PRICING_BODA_BASE_FARE=10000

# Default boda per-km rate in minor units
PRICING_BODA_PER_KM=4000

# Default tuk-tuk base fare in minor units
PRICING_TUKTUK_BASE_FARE=20000

# Default tuk-tuk per-km rate in minor units
PRICING_TUKTUK_PER_KM=6000

# -----------------------------------------------------------------------------
# DISPATCH
# -----------------------------------------------------------------------------
# Offer expiry in seconds
DISPATCH_OFFER_EXPIRY_SECONDS=15

# Maximum re-offer attempts before escalating to dispatcher
DISPATCH_MAX_OFFERS=5

# Maximum search radius for rider candidates in meters
DISPATCH_SEARCH_RADIUS_METERS=5000

# -----------------------------------------------------------------------------
# DARAJA (M-PESA) INTEGRATION
# -----------------------------------------------------------------------------
# Set to 'sandbox' or 'production'
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET

# Business shortcode (paybill or till number)
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online passkey
MPESA_PASSKEY=YOUR_LIPA_NA_MPESA_PASSKEY

# STK Push callback URL (must be publicly accessible HTTPS URL)
MPESA_CALLBACK_URL=https://your-domain.co.ke/api/v1/payments/mpesa/callback

# Daraja API base URL (overridden by MPESA_ENV if not set)
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# B2C credentials for payouts (optional)
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://your-domain.co.ke/api/v1/payouts/mpesa/result
MPESA_B2C_QUEUE_TIMEOUT_URL=https://your-domain.co.ke/api/v1/payouts/mpesa/timeout

# -----------------------------------------------------------------------------
# AFRICA'S TALKING (SMS)
# -----------------------------------------------------------------------------
# Set to 'sandbox' or 'production'
AT_ENV=sandbox

AT_API_KEY=YOUR_AT_API_KEY
AT_USERNAME=sandbox
AT_SENDER_ID=Haraka

# Sandbox phone number for testing (Africa's Talking sandbox)
AT_SANDBOX_PHONE=+254700000000

# -----------------------------------------------------------------------------
# ROUTING (OSRM / OpenRouteService)
# -----------------------------------------------------------------------------
# Routing provider: 'osrm' | 'openrouteservice' | 'haversine'
ROUTING_PROVIDER=haversine

# OSRM server URL (if using OSRM)
OSRM_BASE_URL=http://router.project-osrm.org

# OpenRouteService API key (if using ORS)
ORS_API_KEY=

# Road distance factor used when haversine fallback is active
# Multiplied by straight-line distance to estimate road distance
HAVERSINE_ROAD_FACTOR=1.3

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Storage provider: 'local' | 's3' | 'gcs'
STORAGE_PROVIDER=local

# Local storage directory (relative to API app)
STORAGE_LOCAL_DIR=./uploads

# S3 configuration (if using S3/compatible)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Signed URL expiry in seconds (for photo proof access)
STORAGE_SIGNED_URL_EXPIRY=900

# Maximum upload size in bytes (5 MB)
UPLOAD_MAX_SIZE_BYTES=5242880

# Allowed MIME types for delivery photos (comma-separated)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# -----------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@haraka.co.ke
EMAIL_FROM_NAME=Haraka

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push)
# -----------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@haraka.co.ke

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# OTP request rate limit (requests per window per IP)
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000

# General API rate limit
RATE_LIMIT_API_MAX=200
RATE_LIMIT_API_WINDOW_MS=60000

# Location update rate limit per rider (per second)
RATE_LIMIT_LOCATION_MAX=2
RATE_LIMIT_LOCATION_WINDOW_MS=1000

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Pretty print logs in development (disable in production)
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# MONITORING AND OBSERVABILITY
# -----------------------------------------------------------------------------
# Sentry DSN (leave empty to disable)
SENTRY_DSN=

# Prometheus metrics endpoint path
PROMETHEUS_METRICS_PATH=/internal/metrics

# OpenTelemetry collector endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Service name for tracing
OTEL_SERVICE_NAME=haraka-api

# -----------------------------------------------------------------------------
# WORKER
# -----------------------------------------------------------------------------
# Number of notification worker concurrency
WORKER_NOTIFICATION_CONCURRENCY=5

# Number of dispatch worker concurrency
WORKER_DISPATCH_CONCURRENCY=10

# Dead letter job retention in days
WORKER_DEAD_LETTER_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# BACKUP (production)
# -----------------------------------------------------------------------------
# Database backup storage path or S3 URI
BACKUP_DESTINATION=s3://your-backup-bucket/haraka-db-backups

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# AWS credentials for backup (if using S3)
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Allowed admin IP addresses (comma-separated, empty = all)
ADMIN_ALLOWED_IPS=

# SOS emergency notification recipient (e.g., ops team number or webhook)
SOS_ALERT_PHONE=
SOS_ALERT_EMAIL=

# Maximum failed login attempts before temporary account lock
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=5
# Development-only shared password for seeded merchant, rider, and staff demo accounts.
HARAKA_DEMO_PASSWORD=HarakaDevOnly!2026
# Keep staff MFA enabled unless explicitly testing locally from a loopback connection.
HARAKA_DEV_STAFF_MFA_BYPASS=0

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable wallet top-up and rider payouts
FEATURE_WALLET_ENABLED=false

# Enable scheduled/recurring deliveries
FEATURE_SCHEDULED_DELIVERIES=false

# Enable delivery photo proof
FEATURE_PHOTO_PROOF=false

# Enable B2C M-Pesa payouts
FEATURE_MPESA_B2C=false

# Enable web push notifications
FEATURE_PUSH_NOTIFICATIONS=false
